#!/usr/bin/env python3

import argparse
import os
import signal
import subprocess
import sys
import time


def download(url, audio_format, output_dir, name, playlist):
    output_dir = os.path.expanduser(output_dir)
    os.makedirs(output_dir, exist_ok=True)

    BGUTIL_SERVER = "/usr/bin/bgutil-pot"
    print("⏳ starting server tokens...")
    try:
        server_proc = subprocess.Popen(
            [BGUTIL_SERVER],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except FileNotFoundError:
        print(
            f"❌ error: {BGUTIL_SERVER} was not find in PATH. Download from github or yay. https://github.com/Brainicism/bgutil-ytdlp-pot-provider"
        )
        sys.exit(1)

    time.sleep(1.5)
    direct = f"{output_dir}/{playlist}/{name}.%(ext)s"
    if playlist == "none":
        direct = f"{output_dir}/{name}.%(ext)s"

    command = [
        "yt-dlp",
        "-v",
        "--cookies-from-browser",
        "firefox",
        "--extractor-args",
        "youtube:player_client=web_safari",
        "--socket-timeout",
        "60",
        "--retries",
        "20",
        "-x",
        "--audio-format",
        audio_format,
        "--audio-quality",
        "0",
        "--embed-thumbnail",
        "--add-metadata",
        "--ignore-errors",
        "--no-abort-on-error",
        "-o",
        direct,
        url,
    ]

    try:
        subprocess.run(command, check=True)
        print("✅ Made it")
    except subprocess.CalledProcessError:
        print("❌ Loading errors")
        sys.exit(1)
    finally:
        print("🛑 stopping server tokins...")
        try:
            os.killpg(os.getpgid(server_proc.pid), signal.SIGTERM)
        except ProcessLookupError:
            pass


def main():
    parser = argparse.ArgumentParser(
        prog="ytmdl", description="Download music from YouTube and YouTube Music"
    )

    parser.add_argument("url")

    parser.add_argument(
        "-f",
        "--format",
        default="flac",
        choices=["mp3", "m4a", "opus", "flac"],
        help="change format. defould is flac",
    )

    parser.add_argument(
        "-o",
        "--output",
        default="~/Music",
        help="change a full dir. defoult is ~/Music",
    )

    parser.add_argument(
        "-n",
        "--name",
        default="%(title)s",
        help="change a name song. defoult is title",
    )
    parser.add_argument(
        "-p",
        "--playlist",
        default="%(playlist_title,album|Single)s",
        help="change name playlist name in dir if playlist name = none - playlist in dir will delete. defoult is playlist title,album or single",
    )

    args = parser.parse_args()
    download(args.url, args.format, args.output, args.name, args.playlist)


if __name__ == "__main__":
    main()
